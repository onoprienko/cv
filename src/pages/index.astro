---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Heading from '../components/Heading.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import DataLocationUser from '../components/icons/reference/DataLocationUser.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import Projects from '../components/Projects.astro';
import Summary from '../components/Summary.astro';
import Stars from '../components/Stars.astro';
import { experiences } from '../content/experiences';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Vitalii Onopriienko - Front End Developer</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('cv-theme');
      if (savedTheme === 'black' || savedTheme === 'white') {
        document.documentElement.dataset.theme = savedTheme;
      }
    </script>
  </head>
  <body>
    <Stars />
    <div class="layout">
      <Header />
      <div class="container">
        <div class="main">
          <section>
            <Heading text={'Summary'} />
            <Summary />
          </section>
          <section>
            <Heading text={'Experience'} />
            {experiences.map((exp) => <ExperienceItem exp={exp} />)}
          </section>
        </div>

        <div class="sidebar">
          <section>
            <Heading text={'Education'} />
            <Education />
          </section>
          <section>
            <Heading text={'Certifications'} />
            <Certifications />
          </section>
          <section>
            <Heading text={'Skills'} />
            <Skills />
          </section>
          <section>
            <Heading text={'Projects'} />
            <Projects />
          </section>
        </div>
      </div>

      <DataLocationUser />
    </div>
  </body>
</html>

<style>
  .container {
    display: flex;
    gap: 8rem;
    width: 100%;
  }
  .main {
    width: 100%;
    flex: 2;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .sidebar {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
</style>
