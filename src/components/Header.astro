---
import { Image } from 'astro:assets';
import Mail from './icons/Mail.astro';
import Whatsapp from './icons/Whatsapp.astro';
import Github from './icons/Github.astro';
import Linkedin from './icons/Linkedin.astro';
import Image2020 from '../assets/2020.jpg';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
  <div class="header">
    <Image
      class="image"
      width={128}
      height={128}
      src={Image2020}
      alt="Vitalii Onopriienko"
    />
    <div class="content">
      <h1 class="title">Vitalii Onopriienko</h1>
      <div class="subtitle">Front End Developer</div>
      <div class="links">
        <a href="mailto:onoprienko.vit@gmail.com" target="_blank">
          <Mail class="icon" />
          onoprienko.vit@gmail.com
        </a>
        <a href="https://wa.me/380501863500" target="_blank">
          <Whatsapp class="icon" />
          + 38 050 186 3500
        </a>
        <a href="https://github.com/onoprienko" target="_blank">
          <Github class="icon" />
          github.com/onoprienko
        </a>
        <a
          href="https://www.linkedin.com/in/vitalii-onopriienko/"
          target="_blank"><Linkedin class="icon" />vitalii-onopriienko</a
        >
      </div>
    </div>
    <ThemeToggle />
  </div>
  <style>
    .header {
      padding: 6rem 0 4rem 0;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4rem;
      align-items: center;
    }
    .image {
      border: 1px solid var(--color-text-main);
    }
    .content {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .title {
      text-transform: uppercase;
      font-size: 3.4rem;
      line-height: 1;
      font-weight: bold;
    }
    .subtitle {
      color: var(--color-text-secondary);
      font-size: 2rem;
    }
    .links {
      display: flex;
      font-size: 1.6rem;
      flex-wrap: wrap;
      gap: 1rem 3.2rem;
    }
    .links a {
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }
    .links a:hover {
      text-decoration: underline;
    }
    .icon {
      width: 1.6rem;
      height: 1.6rem;
      margin-right: 0.8rem;
    }
  </style>
</header>
