---

---

<div class="theme-toggle" data-noprint>
  <span>Dark</span>
  <button
    id="theme-toggle"
    class="switch"
    type="button"
    role="switch"
    aria-label="White theme"
    aria-checked="false"
  >
    <span class="switch-thumb"></span>
  </button>
  <span>Light</span>
</div>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
    align-self: flex-start;
    white-space: nowrap;
    position: absolute;
    right: 6rem;
  }
  .switch {
    width: 4.4rem;
    height: 2.4rem;
    padding: 0.2rem;
    border: 1px solid var(--color-control-border);
    border-radius: 1.2rem;
    background: var(--color-control-background);
    cursor: pointer;
  }
  .switch:focus-visible {
    outline: 2px solid var(--color-text-main);
    outline-offset: 3px;
  }
  .switch-thumb {
    display: block;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--color-text-main);
    transition: transform 160ms ease;
  }
  .switch[aria-checked='true'] .switch-thumb {
    transform: translateX(2rem);
  }

  @media screen and (max-width: 1139px) {
    .theme-toggle {
      right: 4rem;
    }
  }
</style>

<script>
  const themeToggle =
    document.querySelector<HTMLButtonElement>('#theme-toggle');

  if (themeToggle) {
    const savedTheme = document.documentElement.dataset.theme ?? 'black';
    themeToggle.setAttribute('aria-checked', String(savedTheme === 'white'));

    themeToggle.addEventListener('click', () => {
      const theme =
        document.documentElement.dataset.theme === 'white' ? 'black' : 'white';
      document.documentElement.dataset.theme = theme;
      themeToggle.setAttribute('aria-checked', String(theme === 'white'));
      localStorage.setItem('cv-theme', theme);
    });
  }
</script>
