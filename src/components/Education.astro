---
import { Image } from 'astro:assets';
import ImageNFAU from '../assets/NFAU.jpg';
---

<div class="education">
  <Image
    width={66}
    height={66}
    class="logo"
    src={ImageNFAU}
    alt="National University of Pharmacy"
  />
  <div class="text">
    <h3 class="title">National University of Pharmacy</h3>
    <div class="subtitle">
      Master's degree, Pharmacy, Pharmaceutical Sciences, and Administration
    </div>
    <div class="info">
      <div class="date">
        <svg fill="currentColor"><use href="#date"></use></svg> 2006 - 2012
      </div>
    </div>
  </div>
</div>

<style>
  .education {
    display: flex;
    gap: 2rem;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .logo {
    border-radius: 50%;
  }
  .title {
    font-size: 1.8rem;
    line-height: 1.4;
  }
  .subtitle {
    font-size: 1.4rem;
    line-height: 1.2;
    color: var(--color-text-secondary);
  }

  .info {
    display: flex;
    font-size: 1.4rem;
    gap: 4rem;
  }
  .info svg {
    width: 1rem;
    height: 1rem;
    margin-right: 0.8rem;
  }
</style>
