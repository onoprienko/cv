---
const { exp } = Astro.props;
import type { Experiense } from '../../types';
---

<div class="exp">
  <h3 class="title">{exp.title}</h3>
  <div class="subtitle">
    {exp.company}
    <svg fill="currentColor"><use href="#user"></use></svg>
    {exp.employees}
  </div>
  <div class="info">
    <div class="date">
      <svg fill="currentColor"><use href="#date"></use></svg>
      {exp.dateStart} - {exp.dateEnd}
    </div>
    <div class="loc">
      <svg fill="currentColor"><use href="#location"></use></svg>
      {exp.location}
    </div>
  </div>
  <p>{exp.companySlogan}</p>
  <p>Responsibilities:</p>
  <ul>
    {exp.responsibilities.map((item: Experiense) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .exp {
    margin-top: 24px;
    padding-bottom: 24px;
    border-bottom: 1px dashed #e6e6e6;
  }
  .exp:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .title {
    font-size: 1.4em;
    margin: 0;
    line-height: 1.1;
    font-weight: 400;
  }
  .subtitle {
    color: #c7c7c7;
    line-height: 1.2;
  }
  .subtitle svg {
    width: 0.8em;
    height: 0.8em;
  }
  ul {
    margin: 0;
    padding: 0 0 0 18px;
    list-style: square outside;
  }
  ul li {
    line-height: 1.3;
  }
  .info {
    display: flex;
    margin: 8px 0 16px;
    font-size: 0.8em;
  }
  .info > * {
    margin-right: 28px;
  }
  .info > :last-child {
    margin-right: 0;
  }
  .info svg {
    width: 0.8em;
    height: 0.8em;
    margin-right: 4px;
  }
  p {
    margin-bottom: 8px;
  }
</style>
