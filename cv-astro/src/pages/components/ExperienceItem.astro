---
const { exp } = Astro.props;
import type { Experiense } from '../../types';
---

<div class="exp">
  <h3 class="title">{exp.title}</h3>
  <div class="subtitle">
    {exp.company}
    <svg fill="currentColor"><use href="#user"></use></svg>
    {exp.employees}
  </div>
  <div class="info">
    <div class="date">
      <svg fill="currentColor"><use href="#date"></use></svg>
      {exp.dateStart} - {exp.dateEnd}
    </div>
    <div class="loc">
      <svg fill="currentColor"><use href="#location"></use></svg>
      {exp.location}
    </div>
  </div>
  <p>{exp.companySlogan}</p>
  <p>Responsibilities:</p>
  <ul>
    {exp.responsibilities.map((item: Experiense) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .exp {
    padding-bottom: 3rem;
    margin-bottom: 2.4rem;
    border-bottom: 1px dashed var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .exp:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .title {
    font-size: 2rem;
    font-weight: bold;
  }
  .subtitle {
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .subtitle svg {
    width: 1rem;
    height: 1rem;
  }
  ul {
    padding: 0 0 0 2rem;
    list-style: square outside;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  ul li {
    line-height: 1.3;
  }
  .info {
    display: flex;
    font-size: 1.4rem;
    gap: 4rem;
  }
  .info svg {
    width: 1rem;
    height: 1rem;
    margin-right: 0.8rem;
  }
</style>
