---
const { exp } = Astro.props;
import type { Experiense } from '../../types';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ImageAskphill from '../../assets/askphill.jpg';
import ImageDigitalsuits from '../../assets/digitalsuits.jpg';
import ImagePromodo from '../../assets/promodo.jpg';
import ImagePDA from '../../assets/PDA.jpg';
import ImageMDS from '../../assets/MDS.jpg';
import ImageIG from '../../assets/IG.jpg';
import ImageSpalah from '../../assets/spalah.jpg';

const companyLogos: Record<string, ImageMetadata> = {
  'Ask Phill': ImageAskphill,
  DigitalSuits: ImageDigitalsuits,
  Promodo: ImagePromodo,
  'Product Design Academy': ImagePDA,
  'Motion Design School': ImageMDS,
  'Insite Group Ukraine': ImageIG,
  'Spalah IT-School': ImageSpalah,
};

const logo = companyLogos[exp.company];
---

<div class="exp">
  <a href={exp.companyUrl} target="_blank" class="head">
    {
      logo && (
        <Image
          width={66}
          height={66}
          class="logo"
          src={logo}
          alt={`${exp.company} logo`}
        />
      )
    }
    <div>
      <h3 class="title">{exp.title}</h3>
      <div class="subtitle">
        {exp.company}
        <svg fill="currentColor"><use href="#user"></use></svg>
        {exp.employees}
      </div>
    </div>
  </a>

  <div class="info">
    <div class="date">
      <svg fill="currentColor"><use href="#date"></use></svg>
      {exp.dateStart} - {exp.dateEnd}
    </div>
    <div class="loc">
      <svg fill="currentColor"><use href="#location"></use></svg>
      {exp.location}
    </div>
  </div>
  <p>{exp.companySlogan}</p>
  <p>Responsibilities:</p>
  <ul>
    {exp.responsibilities.map((item: Experiense) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .exp {
    padding-bottom: 3rem;
    margin-bottom: 3.6rem;
    border-bottom: 1px dashed var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .exp:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .head {
    display: flex;
    gap: 2rem;
    margin-bottom: 1rem;
    text-decoration: none;
  }
  .head:hover {
    text-decoration: underline;
  }
  .title {
    font-size: 2rem;
    font-weight: bold;
  }
  .subtitle {
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .subtitle svg {
    width: 1rem;
    height: 1rem;
  }
  ul {
    padding: 0 0 0 2rem;
    list-style: square outside;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  ul li {
    line-height: 1.3;
  }
  .info {
    display: flex;
    font-size: 1.4rem;
    gap: 4rem;
  }
  .info svg {
    width: 1rem;
    height: 1rem;
    margin-right: 0.8rem;
  }
</style>
