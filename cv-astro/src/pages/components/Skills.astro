---
import { skills } from '../../content/skills';
---

<ul>
  {
    skills.map((skill) => (
      <li>
        <a href={skill.url} target="_blank">
          {skill.name}
        </a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
  }
  li {
    display: inline-block;
    padding: 0.2rem;
    margin: 0 1.6rem 0.8rem 0;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
