---
import { Image } from 'astro:assets';
import { projects } from '../../content/projects';
---

<div class="portfolio">
  {
    projects.map((item) => (
      <a class="item" href={item.href} target="_blank">
        <div>
          <div class="title">{item.alt}</div>
          <div class="description">{item.description}</div>
        </div>
        <div class="image-holder">
          <Image
            class="image"
            width={180}
            height={63}
            src={item.src}
            alt={item.alt}
          />
        </div>
      </a>
    ))
  }
</div>

<style>
  .portfolio {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1rem;
  }
  .item {
    text-decoration: none;
    display: grid;
    grid-template-columns: 5fr 4fr;
    align-items: start;
    gap: 1rem;
  }
  .item:hover .title {
    text-decoration: underline;
  }
  .title {
    margin-bottom: 0.8rem;
  }
  .description {
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }
  .image-holder {
    display: inline-block;
    width: 100%;
    border: 1px dashed var(--color-text-secondary);
    padding: 1.6rem 0;
    line-height: 0;
    background: var(--color-background-bottom);
  }
  img {
    filter: grayscale(10%) sepia(10%) hue-rotate(10deg) saturate(100%);
    transition: 0.3s;
    max-width: 100%;
    width: 100%;
    height: 100%;
  }
  img:hover {
    filter: none;
  }

  :root[data-theme='white'] .image-holder {
    background: var(--color-text-main);
  }
</style>
