---
// TODO: instead use copy of styles of ExperienceItem component use some other approach
---

<div class="exp">
  <h3 class="title">Bachelor Pharmacist</h3>
  <div class="subtitle">National University of Pharmacy Ukraine</div>
  <div class="info">
    <div class="date">
      <svg fill="currentColor"><use href="#date"></use></svg> 2006-2012
    </div>
  </div>
</div>

<style>
  .exp {
    margin-top: 2.4rem;
    padding-bottom: 2.4rem;
    border-bottom: 1px dashed var(--color-text-secondary);
  }
  .exp:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .title {
    font-size: 1.4rem;
    margin: 0;
    line-height: 1.1;
    font-weight: 400;
  }
  .subtitle {
    color: var(--color-text-secondary);
    line-height: 1.2;
  }
  .subtitle svg {
    width: 1rem;
    height: 1rem;
  }
  .info {
    display: flex;
    margin: 0.8rem 0 1.6rem;
    font-size: 0.8em;
  }
  .info > * {
    margin-right: 2.8rem;
  }
  .info > :last-child {
    margin-right: 0;
  }
  .info svg {
    width: 1rem;
    height: 1rem;
    margin-right: 0.4rem;
  }
</style>
